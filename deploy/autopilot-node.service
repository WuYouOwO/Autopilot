[Unit]
Description=Autopilot Managed EasyTier Core Node
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/easytier/easytier-linux-x86_64/easytier-core --config-file /root/workspace/Autopilot/runtime/node1.toml -r 127.0.0.1:15889
Restart=always
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
