[Unit]
Description=Autopilot Zero-Trust Companion Agent
After=network.target autopilot.service autopilot-node.service

[Service]
Type=simple
ExecStart=/root/workspace/Autopilot/apps/agent/bin/autopilot-agent start --hub http://127.0.0.1:8787 --network net_corp_zero_trust --hostname devlab-autopilot-node-01 --rpc-port 15889 --persona workstation
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
