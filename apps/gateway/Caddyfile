{
  admin off
  auto_https off
}

:{$PORT:443} {
  # Health check
  handle /health {
    respond "OK (Autopilot Stateless Gateway)" 200
  }

  # Converge REST API & RPC portal to EasyTier internal 11211
  handle_path /api/* {
    reverse_proxy localhost:11211 {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
    }
  }

  # Converge WebSocket & Web traffic to EasyTier internal 22020
  handle /* {
    reverse_proxy localhost:22020 {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
      header_up Upgrade {>Upgrade}
      header_up Connection {>Connection}
    }
  }
}
